{
  "terminal.integrated.env.windows": {
    "DOTNET_CLI_UI_LANGUAGE": "ja"
  },
  "terminal.integrated.automationProfile.windows": {
    "source": "PowerShell",
    "args": [
      "-NoExit",
      "-Command",
      "chcp 65001 > $null; [Console]::OutputEncoding = [Console]::InputEncoding = [System.Text.UTF8Encoding]::new($false); $OutputEncoding = [Console]::OutputEncoding"
    ]
  }
}
